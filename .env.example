# Copy to .env (auto-loaded at startup, gitignored). Never commit real keys.

# Provider/model selection normally lives in tlde.toml ([providers]/[models]).
# The vars below are an OPTIONAL GLOBAL override applied to EVERY role — leaving
# them UNSET is recommended. If set, they win over the config file (env > toml),
# so a stray value here silently overrides `--config` profiles (e.g. the
# OpenRouter profile used by `make openrouter`). Prefer the `--provider` /
# `--model` CLI flags for one-off overrides.
#
# TLDE_PROVIDER=openrouter   # github | openrouter | anthropic | openai | azure | ollama
# TLDE_MODEL=                # global model override (all roles)
#
# Per-role overrides (optional): TLDE_<ROLE>_MODEL / TLDE_<ROLE>_PROVIDER
#   e.g. TLDE_VISION_PROVIDER=anthropic

# --- Provider API keys (set only the provider you use) ---
# GitHub Copilot (default): no key needed — run `copilot auth login`.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: a HuggingFace token avoids throttled embedder/reranker downloads.
# HF_TOKEN=
